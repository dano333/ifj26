def id [v:Int]: Int
  block{
    if (v:Int > 0):Boolean
      block{
        return v:Int
      }
    else
      block{
        if (v:Int < 0):Boolean
          block{
            return (neg v:Int):Int
          }
        else
          block{
            return 0
          }
      }
  }
